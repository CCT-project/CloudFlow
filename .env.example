# CloudFlow Environment Configuration Template
# Copy this file to .env.local for local overrides.
# NOTE: Never commit sensitive keys or credentials to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Research Simulation Defaults
NEXT_PUBLIC_DEFAULT_SLA_MS=400
NEXT_PUBLIC_DEFAULT_WORKLOAD=Medium

# Authentication & Session Security
# Mandatory in production: Cryptographically random secret for HMAC-SHA256 session signing
# Minimum length: 32 characters (256-bit entropy). Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-secure-random-32-plus-character-secret-in-production"

# PostgreSQL Database Connection - Pooled (Prisma Client Application Runtime)
# Neon pooled connection string with connection pooler enabled (contains '-pooler')
# Format: postgresql://<USER>:<PASSWORD>@<HOST>-pooler.<REGION>.aws.neon.tech/<DATABASE>?sslmode=require&schema=public
# Example: postgresql://postgres:postgres@localhost:5432/cloudflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudflow?schema=public"

# PostgreSQL Database Connection - Direct (Prisma Migrate Deployment)
# Neon direct connection string bypassing connection pooler for schema migrations (without '-pooler')
# Format: postgresql://<USER>:<PASSWORD>@<HOST>.<REGION>.aws.neon.tech/<DATABASE>?sslmode=require&schema=public
# Example: postgresql://postgres:postgres@localhost:5432/cloudflow?schema=public
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cloudflow?schema=public"
